---
import { site, absoluteUrl } from '@/lib/site';

export interface SeoProps {
  title: string;
  description: string;
  /** Ruta absoluta desde la raíz, sin dominio (ej. "/servicios/paginas-web"). */
  path: string;
  ogImage?: string | undefined;
  ogImageAlt?: string | undefined;
  noindex?: boolean | undefined;
  ogType?: 'website' | 'article' | undefined;
}

const {
  title,
  description,
  path,
  ogImage,
  ogImageAlt,
  noindex = false,
  ogType = 'website',
} = Astro.props as SeoProps;

if (import.meta.env.DEV) {
  if (title.length > 60) console.warn(`[Seo] title > 60 car. en ${path}: ${title}`);
  if (description.length > 155) console.warn(`[Seo] description > 155 car. en ${path}`);
}

const canonical = absoluteUrl(path);
const image = absoluteUrl(ogImage ?? '/og-image.png');
const imageAlt = ogImageAlt ?? title;
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta name="robots" content={noindex ? 'noindex,follow' : 'index,follow,max-image-preview:large'} />

<meta property="og:type" content={ogType} />
<meta property="og:locale" content={site.ogLocale} />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={image} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />
