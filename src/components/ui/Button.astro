---
import type { HTMLAttributes } from 'astro/types';
import Icon, { type IconName } from './Icon.astro';

interface Props extends Omit<HTMLAttributes<'a'>, 'class'> {
  href: string;
  variant?: 'primary' | 'secondary' | 'ghost' | 'whatsapp';
  icon?: IconName;
  external?: boolean;
  /** Evento de analítica (ver lib/analytics.ts). */
  track?: string;
  trackLocation?: string;
  class?: string;
}

const {
  href,
  variant = 'primary',
  icon,
  external = /^https?:/.test(href),
  track,
  trackLocation,
  class: className,
  ...rest
} = Astro.props;
---

<a
  href={href}
  class:list={['button', `button-${variant}`, className]}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
  data-track={track}
  data-track-location={trackLocation}
  {...rest}
>
  <slot />
  {icon && <Icon name={icon} size={16} />}
</a>

<style>
  .button {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    display: inline-flex;
    min-height: 50px;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    padding: 0 19px;
    border: 1px solid transparent;
    border-radius: var(--radius-sm);
    font-size: var(--text-sm);
    font-weight: 700;
    line-height: 1.35;
    transition:
      transform 0.18s ease,
      color 0.18s ease,
      border-color 0.18s ease,
      background-color 0.18s ease;
  }

  .button:hover {
    transform: translateY(-2px);
  }

  /* Destello que cruza el botón al pasar el cursor (primario y WhatsApp). */
  .button-primary::after,
  .button-whatsapp::after {
    position: absolute;
    z-index: -1;
    inset: 0;
    background: linear-gradient(110deg, transparent 30%, var(--color-text) 50%, transparent 70%);
    content: '';
    opacity: 0.35;
    transform: translateX(-120%);
    transition: transform 0.6s ease;
  }

  .button-primary:hover::after,
  .button-whatsapp:hover::after,
  .button-primary:focus-visible::after,
  .button-whatsapp:focus-visible::after {
    transform: translateX(120%);
  }

  .button-whatsapp {
    border-color: var(--color-whatsapp);
    color: var(--color-on-whatsapp);
    background: var(--color-whatsapp);
    box-shadow: var(--glow-whatsapp);
    animation: button-wa-shine 4.5s ease-in-out 2s infinite;
  }

  .button-whatsapp:hover,
  .button-whatsapp:focus-visible {
    background: var(--color-whatsapp-strong);
  }

  /* Cada pocos segundos el botón verde "respira" para atraer la mirada. */
  @keyframes button-wa-shine {
    0%,
    82%,
    100% {
      box-shadow: var(--glow-whatsapp);
    }
    90% {
      box-shadow:
        var(--glow-whatsapp),
        0 0 0 7px var(--color-whatsapp-a18);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .button-whatsapp {
      animation: none;
    }

    .button-primary::after,
    .button-whatsapp::after {
      display: none;
    }
  }

  .button-primary {
    border-color: var(--color-cyan);
    color: var(--color-on-cyan);
    background: var(--color-cyan);
  }

  .button-primary:hover,
  .button-primary:focus-visible {
    color: var(--color-bg);
    background: var(--color-cyan-bright);
  }

  .button-secondary {
    border-color: var(--color-border-cta);
    color: var(--color-text);
    background: var(--color-fill-faint);
  }

  .button-secondary:hover,
  .button-secondary:focus-visible {
    border-color: var(--color-cyan-a42);
    background: var(--color-cyan-a06);
  }

  .button-ghost {
    min-height: 44px;
    padding-inline: 4px;
    color: var(--color-cyan);
  }

  .button-ghost:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
</style>
