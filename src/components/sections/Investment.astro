---
import SectionVisual from '../ui/SectionVisual.astro';
import { sectionVisuals } from '@/lib/visuals';
import Button from '../ui/Button.astro';
import SectionLabel from '../ui/SectionLabel.astro';
import { buildWhatsAppUrl, type WhatsAppIntent } from '@/lib/whatsapp';

interface Props {
  index: string;
  note: string;
  maintenance: string;
  /** Mensaje de WhatsApp del servicio. */
  waIntent?: WhatsAppIntent;
}
const { index, note, maintenance, waIntent = 'cotizacion' } = Astro.props;
---

<section class="section-shell section-pad" id="inversion" aria-labelledby="inversion-title">
  <div class="box">
    <div>
      <SectionLabel index={index}>INVERSIÓN</SectionLabel>
      <h2 id="inversion-title" class="visually-hidden">
        Cotización a tu medida
      </h2>
      <p class="price">Cotización a tu medida</p>
      <p class="note">{note}</p>
      <p class="maint">{maintenance}</p>
    </div>
    <div class="actions">
      <Button
        href={buildWhatsAppUrl({ intent: waIntent })}
        variant="whatsapp"
        icon="whatsapp"
        track="cta_whatsapp_click"
        trackLocation="investment"
      >
        Cotizar por WhatsApp
      </Button>
      <Button
        href="/cotizar"
        variant="secondary"
        icon="arrow-right"
        track="cta_quote_click"
        trackLocation="investment"
      >
        Solicitar cotización
      </Button>
    </div>
    <SectionVisual image={sectionVisuals.precios} shape="side" />
  </div>
</section>

<style>
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .box {
    display: grid;
    gap: var(--space-6);
    align-items: end;
    padding: clamp(24px, 5vw, 48px);
    border: 1px solid var(--color-cyan-a25);
    background: var(--color-surface);
  }

  .price {
    margin: 0 0 var(--space-3);
    color: var(--color-cyan);
    font-family: var(--font-heading);
    font-size: clamp(2.2rem, 6vw, 3.6rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .note,
  .maint {
    max-width: 560px;
    margin: 0 0 6px;
    color: var(--color-text-dim);
    font-size: 15px;
  }

  .maint {
    color: var(--color-text-soft);
  }

  @media (min-width: 900px) {
    .box {
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.85fr);
      align-items: center;
    }

    .box > :global(.section-visual) {
      grid-row: 1 / span 2;
      grid-column: 2;
      margin: 0;
    }

    .actions {
      justify-self: start;
    }
  }
</style>
