---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import SectionLabel from '../ui/SectionLabel.astro';
import poster from '@/assets/marca/x-poster.webp';
import heroBg from '@/assets/marca/hero-bg.webp';
import { buildWhatsAppUrl } from '@/lib/whatsapp';

// Datos reales tomados del contenido (nada de cifras escritas a mano).
const servicios = (await getCollection('servicios')).sort((a, b) => a.data.order - b.data.order);
const demos = (await getCollection('proyectos')).filter((p) => p.data.status === 'publicada');

const facts = [
  { value: String(servicios.length), label: 'Servicios digitales' },
  { value: String(demos.length), label: 'Demos navegables' },
  { value: 'A tu medida', label: 'Cotización gratis' },
  { value: 'Lima · LATAM', label: 'Equipo remoto' },
];
---

<section class="hero" id="inicio" aria-labelledby="hero-title" data-scene-anchor>
  <div class="hero-bg" aria-hidden="true">
    <Image
      src={heroBg}
      alt=""
      width={1500}
      format="webp"
      loading="eager"
      decoding="async"
      fetchpriority="low"
    />
  </div>

  <div class="hero-main section-shell">
    <div class="hero-copy">
      <SectionLabel dot>INGENIERÍA DIGITAL · LIMA / REMOTO</SectionLabel>
      <h1 id="hero-title">Web, IA y automatización para vender más y trabajar mejor</h1>
      <p class="hero-lede">
        Creamos páginas web, tiendas virtuales, experiencias 3D, chatbots con IA y automatizaciones
        para que tu negocio atienda más rápido, ordene sus procesos y reciba más consultas de
        clientes.
      </p>
      <div class="hero-actions">
        <Button href="#cotizador" icon="arrow-down" track="cta_quote_click" trackLocation="hero">
          Solicitar cotización
        </Button>
        <Button
          href="#demo"
          variant="secondary"
          icon="arrow-up-right"
          class="hero-ai"
          data-open-assistant="hero"
        >
          <span class="hero-ai-dot" aria-hidden="true"></span>
          Habla con Tommy (IA)
        </Button>
        <Button
          href={buildWhatsAppUrl({ intent: 'general' })}
          variant="whatsapp"
          icon="whatsapp"
          track="cta_whatsapp_click"
          trackLocation="hero"
        >
          WhatsApp
        </Button>
      </div>
      <ul class="hero-trust" aria-label="Cómo trabajamos">
        <li>Propuesta por escrito</li>
        <li>Cotización a tu medida</li>
        <li>
          <a href="/proyectos" data-track="cta_demo_click" data-track-location="hero">
            Demos que puedes probar
          </a>
        </li>
      </ul>
      <p class="hero-diag">
        ¿No sabes por dónde empezar?
        <a href="/diagnostico" data-track="cta_diagnostic_click" data-track-location="hero">
          Pide tu Diagnóstico Digital Gratuito de 15 minutos →
        </a>
      </p>
    </div>

    <div class="hero-visual" id="hero-stage" aria-hidden="true">
      <div class="hero-orbit orbit-a"></div>
      <div class="hero-orbit orbit-b"></div>
      <Image
        class="hero-poster"
        src={poster}
        alt=""
        width={440}
        format="webp"
        loading="eager"
        decoding="async"
      />
      <canvas id="hero3d"></canvas>
      <span class="float f1">
        <i></i>Asistente con IA
      </span>
      <span class="float f2">
        <i></i>Pedidos por WhatsApp
      </span>
      <span class="float f3">
        <i></i>Cotizador en línea
      </span>
    </div>
  </div>

  <div class="hero-strip section-shell">
    <ul class="strip-services" aria-label="Servicios">
      {servicios.map((s) => (
        <li>
          <a href={`/servicios/${s.id}`} data-track="service_click" data-track-location="hero">
            <Icon name={s.data.icon} size={22} />
            <span>{s.data.title}</span>
          </a>
        </li>
      ))}
    </ul>
    <dl class="strip-facts">
      {facts.map((f) => (
        <div>
          <dt>{f.label}</dt>
          <dd>{f.value}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    z-index: -1;
    inset: 0 0 auto auto;
    width: 100%;
    height: 100%;
    opacity: 0.5;
    -webkit-mask-image: linear-gradient(to bottom, #000 55%, transparent 100%);
    mask-image: linear-gradient(to bottom, #000 55%, transparent 100%);
  }

  .hero-bg :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 70% 40%;
  }

  .hero::after {
    position: absolute;
    z-index: -1;
    inset: 0;
    background: var(--color-bg-a78);
    content: '';
    pointer-events: none;
  }

  .hero-main {
    position: relative;
    display: grid;
    align-items: center;
    gap: var(--space-6);
    padding-block: clamp(36px, 4.5vw, 60px) clamp(20px, 3vw, 32px);
  }

  .hero-copy {
    position: relative;
    z-index: var(--z-base);
    max-width: 640px;
  }

  .hero h1 {
    font-size: clamp(2.2rem, 4.6vw, 3.7rem);
    line-height: 1.04;
  }

  .hero-lede {
    max-width: 560px;
    margin-bottom: 28px;
    color: var(--color-text-soft);
    font-size: var(--text-lede);
    line-height: 1.7;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
  }

  .hero-trust {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    padding: 0;
    margin: var(--space-6) 0 0;
    color: var(--color-text-dim);
    font-size: 14px;
    list-style: none;
  }

  .hero-trust li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .hero-trust a {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: var(--color-cyan-a42);
    text-underline-offset: 4px;
  }

  .hero-trust a:hover {
    color: var(--color-cyan);
  }

  /* Botón de la IA: borde cian vivo y punto que late. */
  .hero-actions :global(.hero-ai) {
    border-color: var(--color-cyan-a42);
    box-shadow: var(--glow-cyan);
  }

  .hero-ai-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-cyan);
    box-shadow: 0 0 0 0 var(--color-cyan-a42);
    animation: hero-ai-pulse 2s ease-out infinite;
  }

  @keyframes hero-ai-pulse {
    to {
      box-shadow: 0 0 0 9px transparent;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-ai-dot {
      animation: none;
    }
  }

  .hero-trust li::before {
    width: 14px;
    height: 14px;
    flex: 0 0 auto;
    border: 1px solid var(--color-cyan);
    border-radius: 50%;
    background: radial-gradient(circle, var(--color-cyan) 35%, transparent 40%);
    content: '';
  }

  .hero-diag {
    margin: var(--space-4) 0 0;
    color: var(--color-text-dim);
    font-size: 14px;
  }

  .hero-diag a {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    margin-left: 6px;
    color: var(--color-cyan);
    text-decoration: underline;
    text-decoration-color: var(--color-cyan-a42);
    text-underline-offset: 4px;
  }

  /* ---------- Escenario de la X + tarjetas flotantes ---------- */
  .hero-visual {
    position: relative;
    display: grid;
    width: min(70%, 280px);
    aspect-ratio: 1;
    place-items: center;
    justify-self: center;
    color: var(--color-cyan);
  }

  .hero-visual::before {
    position: absolute;
    inset: 8%;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      var(--color-cyan-a25),
      var(--color-violet-a25) 48%,
      transparent 70%
    );
    filter: blur(30px);
    content: '';
    animation: halo 6s ease-in-out infinite;
  }

  .hero-visual :global(.hero-poster),
  #hero3d {
    position: absolute;
    inset: 4%;
    width: 92%;
    height: 92%;
    object-fit: contain;
  }

  .hero-visual :global(.hero-poster) {
    z-index: var(--z-base);
    animation: float-y 7s ease-in-out infinite;
    transition: opacity 0.7s ease;
  }

  #hero3d {
    z-index: 2;
    opacity: 0;
    transition: opacity 0.7s ease;
  }

  .hero-visual:global(.is-3d) #hero3d {
    opacity: 1;
  }

  .hero-visual:global(.is-3d) :global(.hero-poster) {
    opacity: 0;
  }

  .hero-orbit {
    position: absolute;
    width: 78%;
    aspect-ratio: 1;
    border: 1px solid var(--color-cyan-a25);
    border-radius: 50%;
  }

  .orbit-a {
    animation: orbit-rotate 34s linear infinite;
  }

  .orbit-b {
    width: 100%;
    border-color: var(--color-violet-a25);
    animation: orbit-rotate 46s linear infinite reverse;
  }

  .float {
    position: absolute;
    z-index: 3;
    display: none;
    align-items: center;
    gap: 8px;
    padding: 9px 14px;
    border: 1px solid var(--color-border-strong);
    background: var(--glass-bg);
    color: var(--color-text);
    font-size: 13px;
    white-space: nowrap;
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    animation: float-y 7s ease-in-out infinite;
  }

  .float i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-cyan);
  }

  .f2 {
    animation-delay: -2.4s;
  }
  .f2 i {
    background: var(--color-violet-soft);
  }
  .f3 {
    animation-delay: -4.6s;
  }

  /* ---------- Franja inferior ---------- */
  .hero-strip {
    display: grid;
    gap: var(--space-5);
    padding-block: var(--space-5) var(--space-6);
    border-top: 1px solid var(--color-border);
  }

  .strip-services {
    display: grid;
    padding: 0;
    margin: 0;
    gap: 8px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    list-style: none;
  }

  .strip-services a {
    display: flex;
    min-height: 56px;
    align-items: center;
    gap: 10px;
    padding: 10px 14px;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    color: var(--color-text-soft);
    font-size: 14px;
    line-height: 1.25;
    transition:
      border-color 0.2s ease,
      color 0.2s ease,
      transform 0.2s ease;
  }

  .strip-services a:hover,
  .strip-services a:focus-visible {
    border-color: var(--color-cyan-a42);
    color: var(--color-text);
    transform: translateY(-2px);
  }

  .strip-services :global(.icon) {
    flex: 0 0 auto;
    color: var(--color-cyan);
  }

  .strip-facts {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .strip-facts dt {
    color: var(--color-muted);
    font-family: var(--font-mono, monospace);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .strip-facts dd {
    margin: 2px 0 0;
    color: var(--color-text);
    font-family: var(--font-heading);
    font-size: clamp(1.2rem, 2.4vw, 1.6rem);
  }

  @keyframes orbit-rotate {
    to {
      transform: rotate(1turn);
    }
  }

  @keyframes float-y {
    0%,
    100% {
      transform: translateY(-2%);
    }
    50% {
      transform: translateY(3%);
    }
  }

  @keyframes halo {
    0%,
    100% {
      opacity: 0.75;
      transform: scale(0.95);
    }
    50% {
      opacity: 1;
      transform: scale(1.06);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-visual :global(.hero-poster),
    .float {
      animation: none;
    }
  }

  @media (min-width: 620px) {
    .strip-services {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 900px) {
    .hero-bg {
      opacity: 0.85;
    }

    .hero::after {
      background: linear-gradient(
        90deg,
        var(--color-bg) 0%,
        var(--color-bg-a78) 38%,
        transparent 75%
      );
    }

    .hero-main {
      grid-template-columns: minmax(0, 1.2fr) minmax(300px, 0.8fr);
    }

    .hero-visual {
      width: min(100%, 440px);
    }

    .float {
      display: inline-flex;
    }
    .f1 {
      top: 10%;
      left: -14%;
    }
    .f2 {
      right: -8%;
      top: 44%;
    }
    .f3 {
      bottom: 8%;
      left: -6%;
    }

    .hero-strip {
      grid-template-columns: 1.7fr 1fr;
      align-items: center;
    }

    .strip-services {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .strip-facts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      padding-left: var(--space-6);
      border-left: 1px solid var(--color-border);
    }
  }

  @media (min-width: 1200px) {
    .hero-main {
      grid-template-columns: minmax(0, 1.1fr) minmax(360px, 0.9fr);
    }

    .strip-services {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }

    .hero-strip {
      grid-template-columns: 1fr;
    }

    .strip-facts {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      padding-left: 0;
      border-left: 0;
    }
  }
</style>
