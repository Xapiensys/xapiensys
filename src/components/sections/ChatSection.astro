---
import SectionLabel from '../ui/SectionLabel.astro';
import ChatDemo from '../islands/ChatDemo';
import { chatSuggestions, getGuidedTopics } from '@/lib/chatGuided';

interface Props {
  index?: string;
}
const { index = '03' } = Astro.props;
const guided = await getGuidedTopics();
---

<section class="section-shell section-pad chat-section" id="demo" aria-labelledby="demo-title">
  <div class="copy">
    <SectionLabel index={index}>DEMO EN VIVO</SectionLabel>
    <h2 id="demo-title" class="display-h2">
      Atención inteligente.
      <br />
      <span class="accent-cyan">Pruébala ahora.</span>
    </h2>
    <p>
      Este asistente usa IA real y conoce nuestros servicios. Pregúntale lo que quieras sobre tu
      proyecto: es el mismo tipo de asistente que podemos construir para tu negocio.
    </p>
    <span class="badge mono">
      <i aria-hidden="true"></i> IA REAL · CON LÍMITES DE USO
    </span>
  </div>
  <ChatDemo client:visible suggestions={chatSuggestions} guided={guided} />
</section>

<style>
  .chat-section {
    display: grid;
    align-items: center;
    gap: 42px;
  }

  .copy > p {
    max-width: 430px;
    margin: 20px 0 22px;
    color: var(--color-text-dim);
    line-height: 1.75;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 9px 11px;
    border: 1px solid var(--color-border);
    color: var(--color-text-dim);
  }

  .badge i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-violet);
  }

  @media (min-width: 900px) {
    .chat-section {
      grid-template-columns: minmax(0, 0.9fr) minmax(420px, 1.1fr);
      gap: clamp(48px, 8vw, 110px);
    }
  }
</style>
