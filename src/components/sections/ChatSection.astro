---
import SectionLabel from '../ui/SectionLabel.astro';
import ChatDemo from '../islands/ChatDemo';
import { chatSuggestions, getGuidedTopics } from '@/lib/chatGuided';
import { getImage } from 'astro:assets';
import tommyAvatar from '@/assets/marca/tommy-avatar.webp';
import tommyPortrait from '@/assets/marca/tommy.webp';
import ProjectImage from '../ui/ProjectImage.astro';

interface Props {
  index?: string;
}
const { index = '03' } = Astro.props;
const guided = await getGuidedTopics();
const avatar = await getImage({ src: tommyAvatar, width: 96, height: 96, format: 'webp' });
---

<section class="section-shell section-pad chat-section" id="demo" aria-labelledby="demo-title">
  <div class="copy">
    <SectionLabel index={index}>DEMO EN VIVO</SectionLabel>
    <h2 id="demo-title" class="display-h2">
      Conoce a Tommy.
      <br />
      <span class="accent-cyan">Tu asistente con IA.</span>
    </h2>
    <figure class="portrait">
      <ProjectImage
        src={tommyPortrait}
        alt="Tommy, el asistente con IA de Xapiensys: un cazador tecnológico con casco y visor cian"
        sizes="160px"
      />
    </figure>
    <p>
      Tommy rastrea lo que frena a tu negocio: te orienta, arma tu cotización y te conecta con el
      equipo. Hasta te pone música. Es el mismo tipo de asistente que podemos construir para tu
      negocio.
    </p>
    <span class="badge mono">
      <i aria-hidden="true"></i> IA REAL · CON LÍMITES DE USO
    </span>
  </div>
  <ChatDemo client:visible suggestions={chatSuggestions} guided={guided} avatarSrc={avatar.src} />
</section>

<style>
  .chat-section {
    display: grid;
    align-items: center;
    gap: 42px;
  }

  .portrait {
    width: 132px;
    margin: 22px 0 0;
    overflow: hidden;
    border: 1px solid var(--color-cyan-a42);
    border-radius: 50%;
    aspect-ratio: 1;
    box-shadow: var(--glow-cyan);
  }

  .portrait :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 22%;
  }

  .copy > p {
    max-width: 430px;
    margin: 20px 0 22px;
    color: var(--color-text-dim);
    line-height: 1.75;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 9px 11px;
    border: 1px solid var(--color-border);
    color: var(--color-text-dim);
  }

  .badge i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-violet);
  }

  @media (min-width: 900px) {
    .chat-section {
      grid-template-columns: minmax(0, 0.9fr) minmax(420px, 1.1fr);
      gap: clamp(48px, 8vw, 110px);
    }
  }
</style>
