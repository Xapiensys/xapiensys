---
import { getCollection } from 'astro:content';
import SectionLabel from '../ui/SectionLabel.astro';
import Quoter from '../islands/Quoter';
import { formatSoles } from '@/lib/quoteOptions';

interface Props {
  index?: string;
}
const { index = '07' } = Astro.props;
const servicios = (await getCollection('servicios')).sort((a, b) => a.data.order - b.data.order);
---

<section class="section-shell section-pad pricing" id="cotizador" aria-labelledby="pricing-title">
  <div class="copy">
    <SectionLabel index={index}>INVERSIÓN ORIENTATIVA</SectionLabel>
    <h2 id="pricing-title" class="display-h2">
      Rangos claros.
      <br />
      <span class="accent-violet">Sin sorpresas.</span>
    </h2>
    <p>
      Precios de referencia en soles. Responde 5 preguntas y te mostramos un rango para tu caso; el
      monto final lo confirmamos por escrito.
    </p>
    <ul class="ranges">
      {servicios.map((s) => (
        <li>
          <a href={`/servicios/${s.id}`}>{s.data.title}</a>
          <span>
            {s.data.priceFrom ? `desde ${formatSoles(s.data.priceFrom)}` : 'requiere diagnóstico'}
          </span>
        </li>
      ))}
      <li>
        <span>Mantenimiento mensual</span>
        <span>S/ 150 – 400 / mes</span>
      </li>
    </ul>
  </div>
  <div class="tool">
    <Quoter client:visible variant="embedded" />
    <noscript>
      <p>
        El cotizador necesita JavaScript. <a href="/contacto">Escríbenos aquí</a> y te enviamos un
        rango.
      </p>
    </noscript>
  </div>
</section>

<style>
  .pricing {
    display: grid;
    gap: var(--space-10);
    align-items: start;
  }

  .copy > p {
    max-width: 460px;
    margin: 20px 0 24px;
    color: var(--color-text-dim);
    line-height: 1.75;
  }

  .ranges {
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--color-border);
    list-style: none;
  }

  .ranges li {
    display: flex;
    min-height: 52px;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    border-bottom: 1px solid var(--color-border);
    color: var(--color-text-soft);
    font-size: 14px;
  }

  .ranges a:hover {
    color: var(--color-cyan);
  }

  .ranges li > span:last-child {
    color: var(--color-cyan);
    font-family: var(--font-mono);
    font-size: 12px;
    text-align: right;
  }

  .tool {
    min-height: 520px;
  }

  @media (min-width: 900px) {
    .pricing {
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
      gap: clamp(40px, 6vw, 90px);
    }
  }
</style>
