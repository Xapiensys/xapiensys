---
import SectionVisual from '../ui/SectionVisual.astro';
import { sectionVisuals } from '@/lib/visuals';
import { getCollection } from 'astro:content';
import SectionLabel from '../ui/SectionLabel.astro';
import Quoter from '../islands/Quoter';
import { buildWhatsAppUrl } from '@/lib/whatsapp';

interface Props {
  index?: string;
}
const { index = '07' } = Astro.props;
const servicios = (await getCollection('servicios')).sort((a, b) => a.data.order - b.data.order);
---

<section class="section-shell section-pad pricing" id="cotizador" aria-labelledby="pricing-title">
  <div class="copy">
    <SectionLabel index={index}>COTIZACIÓN A MEDIDA</SectionLabel>
    <h2 id="pricing-title" class="display-h2">
      Tu proyecto,
      <br />
      <span class="accent-violet">tu presupuesto.</span>
    </h2>
    <p>
      Cada negocio necesita algo distinto, así que cotizamos a tu medida: desde lo esencial para
      empezar hasta sistemas completos. Cuéntanos qué necesitas y te enviamos una propuesta por
      escrito, sin compromiso.
    </p>
    <ul class="ranges">
      {servicios.map((s) => (
        <li>
          <a href={`/servicios/${s.id}`}>{s.data.title}</a>
          <a
            class="quote-link"
            href={buildWhatsAppUrl({ intent: 'servicio', topic: s.data.title })}
            target="_blank"
            rel="noopener noreferrer"
            data-track="cta_whatsapp_click"
            data-track-location="pricing_list"
          >
            Cotizar <span aria-hidden="true">↗</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
  <div class="tool">
    <Quoter client:visible variant="embedded" />
    <noscript>
      <p>
        El cotizador necesita JavaScript. <a href="/contacto">Escríbenos aquí</a> y te enviamos tu
        cotización.
      </p>
    </noscript>
    <SectionVisual image={sectionVisuals.precios} shape="side" />
  </div>
</section>

<style>
  .pricing {
    display: grid;
    gap: var(--space-10);
    align-items: start;
  }

  .copy > p {
    max-width: 460px;
    margin: 20px 0 24px;
    color: var(--color-text-dim);
    line-height: 1.75;
  }

  .ranges {
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--color-border);
    list-style: none;
  }

  .ranges li {
    display: flex;
    min-height: 52px;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    border-bottom: 1px solid var(--color-border);
    color: var(--color-text-soft);
    font-size: 14px;
  }

  .ranges a:hover {
    color: var(--color-cyan);
  }

  .ranges .quote-link {
    flex: 0 0 auto;
    padding: 6px 12px;
    border: 1px solid var(--color-whatsapp-a42);
    border-radius: var(--radius-full);
    color: var(--color-whatsapp);
    font-size: 12px;
    font-weight: 700;
    transition:
      background-color 0.2s,
      color 0.2s;
  }

  .ranges .quote-link:hover,
  .ranges .quote-link:focus-visible {
    color: var(--color-on-whatsapp);
    background: var(--color-whatsapp);
  }

  .tool {
    min-height: 520px;
  }

  @media (min-width: 900px) {
    .pricing {
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
      gap: clamp(40px, 6vw, 90px);
    }
  }
</style>
