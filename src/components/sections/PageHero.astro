---
import Button from '../ui/Button.astro';
import SectionLabel from '../ui/SectionLabel.astro';
import ProjectImage from '../ui/ProjectImage.astro';
import { buildWhatsAppUrl, type WhatsAppIntent } from '@/lib/whatsapp';
import type { Visual } from '@/lib/visuals';

interface Props {
  label: string;
  title: string;
  lede: string;
  /** Muestra el CTA doble (WhatsApp + cotizador). */
  ctas?: boolean;
  waIntent?: WhatsAppIntent;
  waTopic?: string | undefined;
  trackLocation?: string;
  /** Imagen a la derecha en escritorio (debajo del texto en celular). */
  image?: Visual | undefined;
  /** Muestra el botón para abrir el asistente IA. */
  askAi?: boolean;
}

const {
  label,
  title,
  lede,
  ctas = true,
  waIntent = 'general',
  waTopic,
  trackLocation = 'page_hero',
  image,
  askAi = true,
} = Astro.props;
---

<section
  class:list={['page-hero section-shell', { 'has-image': image }]}
  aria-labelledby="page-title"
  data-scene-anchor
>
  <div class="copy">
    <SectionLabel dot>{label}</SectionLabel>
    <h1 id="page-title">{title}</h1>
    <p class="lede">{lede}</p>
    {ctas && (
      <div class="actions">
        <Button
          href={buildWhatsAppUrl({ intent: waIntent, ...(waTopic ? { topic: waTopic } : {}) })}
          variant="whatsapp"
          icon="whatsapp"
          track="cta_whatsapp_click"
          trackLocation={trackLocation}
        >
          Escríbenos por WhatsApp
        </Button>
        <Button
          href="/cotizar"
          variant="secondary"
          icon="arrow-right"
          track="cta_quote_click"
          trackLocation={trackLocation}
        >
          Cotiza en 1 minuto
        </Button>
        {askAi && (
          <button type="button" class="ask-ai" data-open-assistant={trackLocation}>
            <span aria-hidden="true"></span>
            Habla con Tommy (IA)
          </button>
        )}
      </div>
    )}
    <slot />
  </div>
  {image && (
    <figure class="visual">
      <ProjectImage src={image.src} alt={image.alt} sizes="(min-width: 980px) 560px, 100vw" />
    </figure>
  )}
</section>

<style>
  .page-hero {
    padding-block: clamp(40px, 7vw, 88px) clamp(40px, 6vw, 72px);
    border-bottom: 1px solid var(--color-border);
  }

  h1 {
    font-size: var(--text-h1-page);
    line-height: 1.02;
  }

  .lede {
    max-width: 640px;
    margin-bottom: 28px;
    color: var(--color-text-soft);
    font-size: var(--text-lede);
    line-height: 1.7;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
  }

  .ask-ai {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    gap: 9px;
    padding: 0 6px;
    border: 0;
    color: var(--color-text-soft);
    background: none;
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: var(--color-cyan-a42);
    text-underline-offset: 5px;
    cursor: pointer;
  }

  .ask-ai:hover,
  .ask-ai:focus-visible {
    color: var(--color-cyan);
  }

  .ask-ai span {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-cyan);
    box-shadow: 0 0 0 4px var(--color-cyan-a12);
  }

  .visual {
    position: relative;
    margin: 36px 0 0;
    overflow: hidden;
    border: 1px solid var(--color-border-strong);
    aspect-ratio: 16 / 10;
    background: var(--color-surface-strong);
    box-shadow: var(--glow-violet);
  }

  .visual :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Velo inferior para integrar la imagen con el fondo. */
  .visual::after {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 60%, var(--color-bg-a50));
    content: '';
    pointer-events: none;
  }

  @media (min-width: 980px) {
    .page-hero.has-image {
      display: grid;
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
      align-items: center;
      gap: clamp(32px, 5vw, 72px);
    }

    .has-image .visual {
      margin: 0;
    }

    .has-image h1 {
      font-size: clamp(2.2rem, 4.2vw, 3.6rem);
    }
  }
</style>
