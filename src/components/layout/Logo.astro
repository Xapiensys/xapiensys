---
interface Props {
  label: string;
  class?: string;
}
const { label, class: className } = Astro.props;
---

<a class:list={['brand', className]} href="/" aria-label={label}>
  <svg class="brand-mark" viewBox="490 214 630 482" aria-hidden="true" focusable="false">
    <g class="blue" fill="none" stroke-width="21" stroke-miterlimit="10">
      <path d="M834 410 689 250H549l199 185-228 225h131l112-113"></path>
      <circle class="dot" cx="633" cy="543" r="21"></circle>
    </g>
    <g class="violet" fill="none" stroke-width="21" stroke-miterlimit="10">
      <path d="M846 328l72-78h86"></path>
      <path d="M1034 262 870 435l190 208"></path>
      <path d="M772 478l180 182h106"></path>
      <circle class="dot" cx="1052" cy="244" r="23"></circle>
      <circle class="dot" cx="1066" cy="655" r="21"></circle>
    </g>
  </svg>
  <span>XAPIENSYS</span>
</a>

<style>
  .brand {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    gap: 11px;
    color: var(--color-text);
    font-family: var(--font-heading);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.16em;
    line-height: 1;
  }

  .blue {
    stroke: var(--color-cyan);
  }

  .violet {
    stroke: var(--color-violet-soft);
  }

  .dot {
    stroke: none;
    fill: currentColor;
  }

  .blue .dot {
    fill: var(--color-cyan);
  }

  .violet .dot {
    fill: var(--color-violet-soft);
  }

  .brand-mark {
    display: block;
    width: 44px;
    height: auto;
    aspect-ratio: 630 / 482;
  }
</style>
