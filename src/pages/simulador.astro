---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/sections/PageHero.astro';
import SiteSimulator from '@/components/islands/SiteSimulator';
import FinalCTA from '@/components/sections/FinalCTA.astro';
import { ogPath } from '@/lib/ogPages';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

// Fotos de portada por rubro (generadas para el simulador; ilustrativas).
const files = import.meta.glob<{ default: ImageMetadata }>('../assets/simulador/*.webp', {
  eager: true,
});
const images: Record<string, string> = {};
for (const [path, mod] of Object.entries(files)) {
  const id = path.split('/').pop()!.replace('.webp', '');
  images[id] = (await getImage({ src: mod.default, width: 1200, format: 'webp', quality: 72 })).src;
}
---

<BaseLayout
  title="Simulador de página web gratis con IA | Xapiensys"
  description="Escribe el nombre de tu negocio, elige rubro y estilo, y mira al instante cómo podría verse tu página web. Gratis, con IA y sin registrarte."
  path="/simulador"
  ogImage={ogPath('simulador')}
  breadcrumbs={[
    { name: 'Inicio', path: '/' },
    { name: 'Simulador', path: '/simulador' },
  ]}
  waIntent="simulador"
>
  <PageHero
    label="SIMULADOR · GRATIS CON IA"
    title="Mira tu página web antes de pagar un sol"
    lede="Escribe el nombre de tu negocio, elige tu rubro y un estilo. La IA arma una vista previa con tu nombre en segundos; si te gusta, la hacemos real."
    ctas={false}
  />
  <section class="section-shell section-pad" aria-label="Simulador de página web">
    <SiteSimulator client:load images={images} />
    <noscript>
      <p>
        El simulador necesita JavaScript. <a href="/contacto">Escríbenos</a> y te mostramos una
        propuesta.
      </p>
    </noscript>
  </section>
  <FinalCTA index="01" waIntent="simulador" />
</BaseLayout>
