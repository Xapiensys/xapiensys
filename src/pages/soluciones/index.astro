---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/sections/PageHero.astro';
import SectorsGrid from '@/components/sections/SectorsGrid.astro';
import ServicesGrid from '@/components/sections/ServicesGrid.astro';
import FinalCTA from '@/components/sections/FinalCTA.astro';
import { ogPath } from '@/lib/ogPages';
---

<BaseLayout
  title="Soluciones digitales por sector | Xapiensys"
  description="Web, chatbots con IA y automatización adaptados a clínicas, constructoras, inmobiliarias, comercios y restaurantes en Lima y el Perú."
  path="/soluciones"
  ogImage={ogPath('soluciones')}
  breadcrumbs={[
    { name: 'Inicio', path: '/' },
    { name: 'Soluciones', path: '/soluciones' },
  ]}
>
  <PageHero
    label="SOLUCIONES"
    title="Soluciones digitales por sector"
    lede="Partimos de los problemas concretos de tu rubro y combinamos los servicios que los resuelven."
  />
  <SectorsGrid index="01" title="Elige tu sector" />
  <ServicesGrid index="02" />
  <FinalCTA index="03" />
</BaseLayout>
