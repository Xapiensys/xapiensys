---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/sections/PageHero.astro';
import ProblemGrid from '@/components/sections/ProblemGrid.astro';
import ProcessSteps from '@/components/sections/ProcessSteps.astro';
import TechProof from '@/components/sections/TechProof.astro';
import Coverage from '@/components/sections/Coverage.astro';
import FAQ from '@/components/sections/FAQ.astro';
import FinalCTA from '@/components/sections/FinalCTA.astro';
import SectionLabel from '@/components/ui/SectionLabel.astro';
import { ogPath } from '@/lib/ogPages';

const principles = [
  {
    title: 'El problema primero',
    text: 'No vendemos tecnología por moda. Si una hoja de cálculo bien hecha resuelve tu caso, te lo decimos.',
  },
  {
    title: 'Medir antes de opinar',
    text: 'Cada proyecto define qué se mide (contactos, tiempo ahorrado, velocidad) y se revisa con datos.',
  },
  {
    title: 'Honestidad',
    text: 'Mostramos demos propias etiquetadas como tales. No publicamos clientes, testimonios ni métricas que no podamos respaldar.',
  },
];
---

<BaseLayout
  title="Empresa: quiénes somos | Xapiensys (Xapiens)"
  description="Xapiensys es una agencia de ingeniería web, automatización e IA con base en Lima. Conoce cómo trabajamos, nuestro stack y nuestros principios."
  path="/empresa"
  ogImage={ogPath('empresa')}
  breadcrumbs={[
    { name: 'Inicio', path: '/' },
    { name: 'Empresa', path: '/empresa' },
  ]}
>
  <PageHero
    label="EMPRESA"
    title="Ingeniería digital con base en Lima"
    lede="Somos una agencia de ingeniería de software para pymes y empresas de Perú y Latinoamérica: páginas web, chatbots con IA, automatización y sistemas a medida."
  />

  <section class="section-shell section-pad about" aria-labelledby="about-title">
    <SectionLabel index="01">QUIÉNES SOMOS</SectionLabel>
    <h2 id="about-title" class="visually-hidden">
      Quiénes somos
    </h2>
    <div class="prose">
      <p>
        <strong>Xapiensys</strong> nace para que las empresas de nuestra región usen la tecnología
        como una herramienta de negocio y no como un gasto difícil de justificar. Trabajamos desde
        Lima con clientes de todo el Perú y de forma remota con Latinoamérica.
      </p>
      <p>
        Quizá nos encontraste como <strong>Xapiens</strong> o escrito <strong>Xapiensis</strong>:
        somos la misma empresa.
      </p>
      <p>
        Este mismo sitio es nuestra carta de presentación: está construido con la arquitectura que
        proponemos a nuestros clientes (HTML estático, islas de JavaScript solo donde aportan, un
        asistente con IA real y un cotizador con backend propio).
      </p>
      {/* TODO(xapiensys): revisar el texto de misión y agregar equipo/fundadores (nombres, roles, foto real) cuando se aprueben. */}
    </div>
  </section>

  <ProblemGrid
    index="02"
    id="principios"
    label="PRINCIPIOS"
    title="Cómo pensamos"
    items={principles}
    accent="cyan"
  />
  <ProcessSteps index="03" />
  <TechProof />
  <Coverage index="04" />
  <FAQ page="empresa" index="05" title="Más preguntas" />
  <FinalCTA index="06" />
</BaseLayout>

<style>
  .about .prose {
    font-size: 17px;
  }
</style>
