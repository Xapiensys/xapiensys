---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/sections/PageHero.astro';
import DemoShowcase from '@/components/sections/DemoShowcase.astro';
import FinalCTA from '@/components/sections/FinalCTA.astro';
import { ogPath } from '@/lib/ogPages';
---

<BaseLayout
  title="Proyectos y demos propias | Xapiensys"
  description="Laboratorio de Xapiensys: demos propias para clínicas, constructoras y comercios, con métricas técnicas medidas. Sin casos inventados."
  path="/proyectos"
  ogImage={ogPath('proyectos')}
  breadcrumbs={[
    { name: 'Inicio', path: '/' },
    { name: 'Proyectos', path: '/proyectos' },
  ]}
>
  <PageHero
    label="LABORATORIO"
    title="Proyectos y demos propias"
    lede="Hoy mostramos demos que construimos nosotros, claramente etiquetadas. Cuando un cliente nos autorice a publicar su caso, aparecerá aquí con métricas reales."
  />
  <DemoShowcase index="01" />
  <FinalCTA index="02" />
</BaseLayout>
