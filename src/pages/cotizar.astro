---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/sections/PageHero.astro';
import { sectionVisuals } from '@/lib/visuals';
import Quoter from '@/components/islands/Quoter';
import FAQ from '@/components/sections/FAQ.astro';
import { ogPath } from '@/lib/ogPages';
---

<BaseLayout
  title="Cotiza tu página web, chatbot o automatización | Xapiensys"
  description="Cuéntanos qué necesitas en 5 preguntas y te enviamos una cotización a tu medida para tu web, chatbot con IA o automatización. Sin compromiso."
  path="/cotizar"
  ogImage={ogPath('cotizar')}
  breadcrumbs={[
    { name: 'Inicio', path: '/' },
    { name: 'Cotizar', path: '/cotizar' },
  ]}
  waIntent="cotizacion"
>
  <PageHero
    label="COTIZADOR"
    title="Cotiza tu proyecto en 1 minuto"
    lede="Cinco preguntas y te enviamos una propuesta a tu medida por escrito, sin compromiso. Tu código te permite seguir la conversación por WhatsApp."
    ctas={false}
    image={sectionVisuals.precios}
  />
  <section class="section-shell section-pad" aria-label="Cotizador">
    <div class="tool">
      <Quoter client:load variant="page" />
      <noscript>
        <p>
          El cotizador necesita JavaScript. <a href="/contacto">Escríbenos aquí</a> y te enviamos tu
          cotización.
        </p>
      </noscript>
    </div>
  </section>
  <FAQ page="paginas-web" index="01" title="Dudas sobre la cotización" />
</BaseLayout>

<style>
  .tool {
    max-width: 820px;
    min-height: 520px;
  }
</style>
