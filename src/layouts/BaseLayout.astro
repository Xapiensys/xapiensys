---
import '@/styles/tokens.css';
import '@/styles/global.css';
import Seo, { type SeoProps } from '@/components/seo/Seo.astro';
import SchemaOrg, { type SchemaProps, type Crumb } from '@/components/seo/SchemaOrg.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import WhatsAppFloat from '@/components/layout/WhatsAppFloat.astro';
import AssistantDock from '@/components/islands/AssistantDock';
import MusicPlayer from '@/components/islands/MusicPlayer';
import PromoBar from '@/components/layout/PromoBar.astro';
import { getImage } from 'astro:assets';
import tommyAvatar from '@/assets/marca/tommy-avatar.webp';
import { chatSuggestions, getGuidedTopics } from '@/lib/chatGuided';
import Breadcrumbs from '@/components/layout/Breadcrumbs.astro';
import IntroLoader from '@/components/layout/IntroLoader.astro';
import { ClientRouter } from 'astro:transitions';
import { site } from '@/lib/site';
import type { WhatsAppIntent } from '@/lib/whatsapp';

interface Props extends SeoProps {
  breadcrumbs?: Crumb[] | undefined;
  service?: SchemaProps['service'];
  creativeWork?: SchemaProps['creativeWork'];
  waIntent?: WhatsAppIntent;
  waTopic?: string | undefined;
}

const { breadcrumbs, service, creativeWork, waIntent, waTopic, ...seo } = Astro.props;
const guided = await getGuidedTopics();
const avatar = await getImage({ src: tommyAvatar, width: 96, height: 96, format: 'webp' });
---

<!doctype html>
<html lang="es-PE">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      (function () {
        var root = document.documentElement;
        root.classList.add('js');
        // Pantalla de carga: solo la primera vez en la sesión y sin "reducir movimiento".
        try {
          if (
            !sessionStorage.getItem('xp_intro') &&
            !matchMedia('(prefers-reduced-motion: reduce)').matches
          ) {
            sessionStorage.setItem('xp_intro', '1');
            root.classList.add('intro');
          }
        } catch (e) {}
      })();
    </script>
    <meta name="theme-color" content="#0a0a0f" />
    <link
      rel="preload"
      href="/fonts/space-grotesk-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <Seo {...seo} />
    <SchemaOrg
      path={seo.path}
      title={seo.title}
      description={seo.description}
      breadcrumbs={breadcrumbs}
      service={service}
      creativeWork={creativeWork}
    />
    <meta name="google-site-verification" content={site.googleSiteVerification} />
    <!-- Navegación sin recarga: la música y Tommy siguen entre páginas. -->
    <ClientRouter fallback="swap" />
  </head>
  <body>
    <IntroLoader />
    <div class="nav-progress" aria-hidden="true" transition:persist="nav-progress"></div>
    <a class="skip-link" href="#contenido">
      Saltar al contenido
    </a>
    <canvas id="bg" aria-hidden="true"></canvas>
    <div class="scroll-progress" aria-hidden="true"></div>
    <div class="cursor-glow" aria-hidden="true"></div>
    <PromoBar />
    <Header />
    {breadcrumbs && <Breadcrumbs items={breadcrumbs} />}
    <main id="contenido">
      <slot />
    </main>
    <Footer />
    <WhatsAppFloat intent={waIntent} topic={waTopic} />
    <AssistantDock
      transition:persist="tommy"
      client:idle
      suggestions={chatSuggestions}
      guided={guided}
      avatarSrc={avatar.src}
    />
    <MusicPlayer transition:persist="radio" client:idle />

    <script>
      import { captureAttribution, scheduleGa4, track, type AnalyticsEvent } from '@/lib/analytics';
      import { PUBLIC_GA4_ID } from 'astro:env/client';

      captureAttribution();
      scheduleGa4(PUBLIC_GA4_ID);

      // Todo CTA con data-track dispara su evento (sin JS por componente).
      document.addEventListener('click', (event) => {
        const el = (event.target as Element | null)?.closest<HTMLElement>('[data-track]');
        if (!el?.dataset.track) return;
        track(el.dataset.track as AnalyticsEvent, { location: el.dataset.trackLocation });
      });
    </script>
    <script>
      import { bootScene } from '@/components/islands/sceneBoot';
      import { bootFx } from '@/components/islands/fx';
      import { bootSfx } from '@/lib/sfx';
      import { onPageLoad } from '@/lib/pageLifecycle';

      bootSfx();
      // Escena 3D y efectos de la página actual (se desmontan al navegar).
      onPageLoad((signal) => {
        bootScene(signal);
        bootFx(signal);
      });

      // Al cambiar de página, <html> llega sin las clases del cliente: se reponen.
      document.addEventListener('astro:after-swap', () => {
        document.documentElement.classList.add('js');
      });

      // Barra de progreso fina mientras se carga la página siguiente.
      const bar = document.querySelector<HTMLElement>('.nav-progress');
      document.addEventListener('astro:before-preparation', () => {
        bar?.classList.remove('is-done');
        bar?.classList.add('is-loading');
      });
      document.addEventListener('astro:after-swap', () => {
        bar?.classList.remove('is-loading');
        bar?.classList.add('is-done');
      });
    </script>
  </body>
</html>

<style is:global>
  /* Barra de navegación entre páginas */
  .nav-progress {
    position: fixed;
    z-index: calc(var(--z-skip) + 1);
    top: 0;
    left: 0;
    width: 100%;
    height: 2px;
    background: linear-gradient(90deg, var(--color-cyan), var(--color-violet-soft));
    box-shadow: var(--glow-cyan);
    opacity: 0;
    transform: scaleX(0);
    transform-origin: left;
    pointer-events: none;
  }

  .nav-progress.is-loading {
    opacity: 1;
    transform: scaleX(0.7);
    transition: transform 2.5s cubic-bezier(0.1, 0.7, 0.2, 1);
  }

  .nav-progress.is-done {
    opacity: 0;
    transform: scaleX(1);
    transition:
      transform 0.25s ease,
      opacity 0.4s ease 0.2s;
  }

  /* Transición entre páginas: el contenido sale y entra con un desliz y desenfoque leve. */
  ::view-transition-old(root) {
    animation: 0.22s ease-in both page-out;
  }

  ::view-transition-new(root) {
    animation: 0.38s cubic-bezier(0.2, 0.7, 0.2, 1) both page-in;
  }

  @keyframes page-out {
    to {
      opacity: 0;
      filter: blur(6px);
      transform: translateY(-10px);
    }
  }

  @keyframes page-in {
    from {
      opacity: 0;
      filter: blur(6px);
      transform: translateY(14px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    ::view-transition-old(root),
    ::view-transition-new(root) {
      animation: none;
    }
  }

  .skip-link {
    position: fixed;
    z-index: var(--z-skip);
    top: 12px;
    left: 12px;
    padding: 10px 16px;
    transform: translateY(-160%);
    border: 1px solid var(--color-cyan);
    border-radius: var(--radius-sm);
    color: var(--color-bg);
    background: var(--color-cyan);
    font-weight: 700;
    transition: transform 0.18s ease;
  }

  .skip-link:focus {
    transform: translateY(0);
  }

  #bg {
    position: fixed;
    z-index: var(--z-canvas);
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.6s ease;
  }

  #bg.is-ready {
    opacity: 1;
  }
</style>
