# Todas son opcionales: sin ellas el sitio funciona en modo degradado
# (sin BD → límites en memoria; sin Resend → solo BD; sin LLM → chat en modo guiado).

# Base de datos (Neon o Supabase; usa la URL del pooler)
DATABASE_URL=
# Email transaccional (Resend, con dominio verificado)
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=
# Remitente del dominio verificado, ej. "Xapiensys <leads@xapiensys.com>"
EMAIL_FROM=
# Anti-bot (Cloudflare Turnstile). La site key es pública y se incrusta en el build.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Chat IA (hoy: anthropic). Modelo por defecto: claude-haiku-5-5
LLM_PROVIDER=anthropic
LLM_MODEL=
LLM_API_KEY=
# Tope mensual de tokens (entrada + salida) del chat. Por defecto 2,000,000.
CHAT_MONTHLY_TOKEN_CAP=
# Privacidad: sal para el hash de IPs (cadena aleatoria larga)
IP_HASH_SALT=
# Panel /admin (mínimo 12 caracteres). Sin ella el panel queda desactivado.
ADMIN_PASSWORD=
# Enlace de agenda (Cal.com, Calendly…). Si existe, aparece "Agendar una llamada".
PUBLIC_BOOKING_URL=
# Analítica
PUBLIC_GA4_ID=
PUBLIC_SITE_URL=https://xapiensys.com
